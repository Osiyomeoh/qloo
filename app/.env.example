# Server side only. Never prefix these with VITE_ (that would ship them to the browser).
QLOO_API_KEY=

# Claude on AWS Bedrock. On Vercel use the BEDROCK_* names (Vercel reserves AWS_*).
BEDROCK_REGION=
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
# Locally you can instead set AWS_REGION and use the standard AWS chain (AWS_PROFILE, keys or a role).
# AWS_REGION=

# Optional: Bedrock model or inference-profile IDs (default us.anthropic.claude-sonnet-4-6).
# BEDROCK_AGENT_MODEL=
# BEDROCK_VISION_MODEL=

# Optional: key that signs the agent session the browser holds. Unset = derived from BEDROCK_SECRET_ACCESS_KEY.
# AGENT_STATE_SECRET=

# Browser build flag: 1 = talk to /api (live Qloo + agent). Unset = labelled sample data.
VITE_LIVE=1
